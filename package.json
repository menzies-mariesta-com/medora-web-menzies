{
	"name": "medora-web-menzies",
	"private": true,
	"version": "1.5.0",
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS=--max-old-space-size=8192 vite dev --host 0.0.0.0 --port 4002",
		"dev:with-paraglide": "npm run paraglide && npm run dev",
		"dev:vite": "npm run dev",
		"prebuild": "npm run paraglide",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
		"paraglide:ci": "node --max-old-space-size=4096 scripts/compile-paraglide.mjs",
		"vite:build:ci": "NETLIFY=true node --max-old-space-size=4608 ./node_modules/vite/bin/vite.js build",
		"build:netlify": "npm run paraglide:ci && npm run vite:build:ci",
		"build:github": "npm run paraglide:ci && NETLIFY=true node --max-old-space-size=7680 ./node_modules/vite/bin/vite.js build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-ui-boundary.mjs && node scripts/check-security-markup.mjs && node scripts/check-public-seo.mjs && node scripts/check-tooltip-placement.mjs && node scripts/check-kit-prerender.mjs && node scripts/check-wash-ui.mjs && node scripts/verify-document-catalog.mjs && node scripts/check-docs-manifest.mjs && NODE_OPTIONS=--max-old-space-size=8192 npm run build",
		"check:kit-prerender": "node scripts/check-kit-prerender.mjs",
		"verify-document-catalog": "node scripts/verify-document-catalog.mjs",
		"docs:manifest": "node scripts/generate-docs-manifest.mjs",
		"check:docs-manifest": "node scripts/check-docs-manifest.mjs",
		"check:docs": "node scripts/check-docs-manifest.mjs && node scripts/verify-workflow-docs.mjs",
		"check:workflow-docs": "node scripts/verify-workflow-docs.mjs",
		"docs:capture": "node --env-file=.env scripts/docs-capture.mjs",
		"docs:capture:resume": "node --env-file=.env scripts/docs-capture.mjs -- --resume",
		"docs:capture:run": "npx tsx --env-file=.env scripts/docs-capture/run-capture.ts",
		"docs:capture:preflight": "npx tsx --env-file=.env scripts/docs-capture/preflight.ts",
		"docs:capture:2fa:disable": "DOCS_CAPTURE_ALLOW_2FA_TOGGLE=1 node --env-file=.env scripts/docs-capture-2fa.mjs disable",
		"docs:capture:2fa:restore": "DOCS_CAPTURE_ALLOW_2FA_TOGGLE=1 node --env-file=.env scripts/docs-capture-2fa.mjs restore",
		"check:ui-boundary": "node scripts/check-ui-boundary.mjs",
		"check:public-seo": "node scripts/check-public-seo.mjs",
		"check:security-markup": "node scripts/check-security-markup.mjs",
		"check:tooltip-placement": "node scripts/check-tooltip-placement.mjs",
		"check:wash-ui": "node scripts/check-wash-ui.mjs",
		"check:wash-pages": "node scripts/crawl-medora-pages.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"paraglide": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/compile-paraglide.mjs",
		"paraglide:clean": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/compile-paraglide.mjs --clean",
		"paraglide:message-modules": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/compile-paraglide.mjs --message-modules",
		"paraglide:message-modules:clean": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/compile-paraglide.mjs --clean --message-modules",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:baseline:sql": "node scripts/drizzle-baseline-print-sql.mjs",
		"db:studio": "drizzle-kit studio",
		"db:seed": "npm run db:seed:master && npm run db:seed:auth && npm run db:seed:information && npm run db:seed:marketplace",
		"db:seed:transaction": "npx tsx --env-file=.env src/lib/server/db/seed/transaction-table-seed.ts",
		"db:seed:visit-history": "npx tsx --env-file=.env src/lib/server/db/seed/visit-history-demo-seed.ts",
		"db:seed:auth": "npx tsx --env-file=.env src/lib/server/db/seed/auth-table-seed.ts",
		"db:seed:master": "npx tsx --env-file=.env src/lib/server/db/seed/master-table-seed.ts",
		"db:seed:information": "npx tsx --env-file=.env src/lib/server/db/seed/information-table-seed.ts",
		"db:patch:nursing-ed-nav": "node --env-file=.env scripts/patch-nursing-ed-nav-pages.mjs",
		"db:seed:marketplace": "npx tsx --env-file=.env src/lib/server/db/seed/marketplace-table-seed.ts",
		"db:backfill:patient-role": "npx tsx --env-file=.env scripts/backfill-patient-role.ts",
		"db:backfill:patient-default-password": "npx tsx --env-file=.env scripts/backfill-patient-default-password.ts",
		"db:seed:docs-demo": "npx tsx --env-file=.env src/lib/server/db/seed/docs-demo-hospital-seed.ts",
		"db:seed:docs-demo-inventory": "npx tsx --env-file=.env src/lib/server/db/seed/inventory-docs-demo-seed.ts",
		"db:import:icd": "npx tsx --env-file=.env scripts/import-icd-codes.ts",
		"db:import:rxnorm": "npx tsx --env-file=.env scripts/import-rxnorm.ts",
		"db:import:ddinter": "npx tsx --env-file=.env scripts/import-ddinter.ts",
		"db:import:openfda-interactions": "npx tsx --env-file=.env scripts/import-openfda-interactions.ts",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "2.9.1",
		"@inlang/plugin-m-function-matcher": "^2.2.0",
		"@inlang/plugin-message-format": "^4.2.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@types/nodemailer": "^7.0.9",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"@vitest/browser-playwright": "^4.0.18",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.1.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.63.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.2",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@changesets/cli": "^2.30.0",
		"@langchain/core": "^1.1.35",
		"@langchain/openai": "^1.3.0",
		"@menzies-mariesta-com/menzies-design-wash-ui": "^1.3.0",
		"@menzies-mariesta-com/wash-ui-mcp": "^1.3.0",
		"@neondatabase/serverless": "^1.0.2",
		"@tigrisdata/storage": "^2.12.1",
		"argon2": "^0.44.0",
		"better-auth": "1.4.18",
		"d3": "^7.9.0",
		"fflate": "0.8.2",
		"gsap": "^3.14.2",
		"html2canvas": "^1.4.1",
		"jsbarcode": "^3.12.3",
		"jspdf": "^4.2.1",
		"nodemailer": "^8.0.0",
		"qrcode": "^1.5.4",
		"uuidv7": "^1.1.0",
		"ws": "^8.18.0",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	}
}
