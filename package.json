{
	"name": "heka",
	"private": true,
	"version": "1.0.44",
	"type": "module",
	"scripts": {
		"dev": "npm run paraglide && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"paraglide": "paraglide-js compile --outdir ./src/lib/paraglide",
		"paraglide:watch": "paraglide-js compile --watch --outdir ./src/lib/paraglide",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:baseline:sql": "node scripts/drizzle-baseline-print-sql.mjs",
		"db:studio": "drizzle-kit studio",
		"db:seed": "npm run db:seed:master && npm run db:seed:auth && npm run db:seed:information && npm run db:seed:marketplace",
		"db:seed:auth": "npx tsx src/lib/server/db/seed/auth-table-seed.ts",
		"db:seed:master": "npx tsx src/lib/server/db/seed/master-table-seed.ts",
		"db:seed:information": "npx tsx src/lib/server/db/seed/information-table-seed.ts",
		"db:seed:marketplace": "npx tsx src/lib/server/db/seed/marketplace-table-seed.ts",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.9.1",
		"@inlang/plugin-m-function-matcher": "^2.2.0",
		"@inlang/plugin-message-format": "^4.2.0",
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@types/nodemailer": "^7.0.9",
		"@vitest/browser-playwright": "^4.0.18",
		"daisyui": "^5.5.14",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.1.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.2",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@changesets/cli": "^2.30.0",
		"@neondatabase/serverless": "^1.0.2",
		"@tigrisdata/storage": "^2.12.1",
		"argon2": "^0.44.0",
		"better-auth": "^1.4.18",
		"cally": "^0.9.1",
		"d3": "^7.9.0",
		"gsap": "^3.14.2",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"nodemailer": "^8.0.0",
		"phse-ui": "^0.0.1",
		"uuidv7": "^1.1.0",
		"zod": "^4.3.6"
	}
}
