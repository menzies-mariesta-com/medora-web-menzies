# Log level: DEBUG | INFO | WARN | ERROR | FATAL | SILENT (default: DEBUG in dev, INFO in prod)
LOG_LEVEL=

# Replace with your DB credentials!
DATABASE_URL=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Local: http://localhost:4002 — Netlify: https://<your-site>.netlify.app (or custom domain)
BETTER_AUTH_BASE_URL=http://localhost:4002
# Comma-separated origins; include your Netlify URL(s) in production
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4002

# Optional: seed SYSTEM_ADMIN on `npm run db:seed:auth` (idempotent upsert by email)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Argon2 password hashing (optional overrides)
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=
ARGON2_HASH_LENGTH=

# Mailing (Namecheap Private Email)
# Host: mail.privateemail.com
# Port 587 = STARTTLS (recommended) | 465 = SSL
# User: full mailbox address | Pass: mailbox password or app password from Private Email
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=

# Optional: receive new IT support ticket notifications (see support-ticket.remote)
SUPPORT_IT_EMAIL=

# WHO ICD-API (register at https://icd.who.int/icdapi; used by npm run db:import:icd)
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
# Optional: flaky networks to Azure North Europe (defaults shown)
# WHO_ICD_REQUEST_TIMEOUT_MS=120000
# WHO_ICD_FETCH_RETRIES=5

# OpenAI (LangChain — server-only; see src/lib/server/ai/)
OPENAI_API_KEY=
# Optional default model when not overridden in code
OPENAI_MODEL=
# Optional: Azure or OpenAI-compatible proxy base URL
OPENAI_BASE_URL=

# Bucket (Tigris)
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_BUCKET=
TIGRIS_STORAGE_ENDPOINT=
TIGRIS_STORAGE_IAM_ENDPOINT=

NODE_AUTH_TOKEN=